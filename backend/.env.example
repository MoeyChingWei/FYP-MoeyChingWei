# Copy to .env and fill in if you want real emails (Gmail App Password, Resend, etc.)

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=OptiMind <your@gmail.com>
# SYSTEM_NOTIFICATION_RECIPIENTS=fypadminsystem@gmail.com,fypexecutive@gmail.com,finalypmanager@gmail.com,chingweimoey@gmail.com,chingweimoey@1utar.my,weiweiweiiiiiii77@gmail.com

# If SMTP_HOST is empty, the server only prints the 6-digit code in the terminal (good for local dev).

# Public base URL for uploaded avatars (no trailing slash). Default: http://localhost:4000
# API_PUBLIC_BASE=http://localhost:4000

# Google reCAPTCHA (v2 Checkbox)
# - Frontend uses the SITE key
# - Backend uses the SECRET to verify tokens
# RECAPTCHA_SECRET=

# AI Vision API (for image analysis in chatbot)
# Choose one provider: 'google' or 'openai'
# VISION_PROVIDER=google

# Option 1: Google Cloud Vision API (Recommended - 1000 free requests/month)
# 1. Create Google Cloud project and enable Vision API
# 2. Create service account and download JSON key
# 3. Set path to the JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=./vision-service-account.json

# Option 2: OpenAI GPT-4 Vision (DeepSeek does not support vision)
# VISION_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# VISION_MODEL=gpt-4-turbo

