@startuml
title Sequence Diagram - Supplier Acknowledgement, Delivery and GRN

actor Supplier
actor Requester
participant "React Supplier/GRN Pages" as FE
participant "Workflow API" as WF
participant "Notification Service" as NS
database "Prisma / PostgreSQL" as DB

Supplier -> FE: Open approved PO
Supplier -> FE: Submit acknowledgement
FE -> WF: PUT supplier-order-acks
WF -> DB: Save ACKNOWLEDGED or REJECTED
alt rejected
  WF -> NS: Notify requester/manager with reason
else acknowledged
  WF -> DB: Create delivery PENDING_DELIVERY
  WF -> NS: Notify requester
end

Supplier -> FE: Enter dispatch and tracking details
FE -> WF: PUT deliveries
WF -> DB: Save delivery SUBMITTED
WF -> NS: Notify requester and create GRN task

Requester -> FE: Compare received goods with PO
Requester -> FE: Submit GRN
FE -> WF: PUT grns
WF -> DB: Save GRN status
alt status = RECEIVED
  WF -> DB: Set fulfillment completed / invoice eligible
  WF -> NS: Notify requester and supplier
else status = DISCREPANCY
  WF -> NS: Notify supplier to resend
  Supplier -> FE: Create replacement delivery
  FE -> WF: PUT deliveries linked to GRN
  WF -> DB: Save new pending delivery cycle
  Requester -> FE: Re-check replacement
  FE -> WF: PUT grn status=COMPLETED when correct
end
@enduml
