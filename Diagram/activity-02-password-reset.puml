@startuml
title Activity 02 - Forgot Password and Reset Password

|User|
start
:Open Forgot Password;
:Enter registered email;
|Frontend|
:Validate email format;
if (Email format valid?) then (yes)
  :POST /api/forgot-password;
  |Backend|
  :Find active account;
  if (Account exists?) then (yes)
    :Generate one-time reset code;
    :Store hashed code and expiry;
    :Send reset email through Gmail;
    |User|
    :Open reset link;
    :Enter code and new password;
    |Frontend|
    :Validate password and confirmation;
    :POST /api/reset-password;
    |Backend|
    :Verify code, expiry and unused flag;
    if (Code valid?) then (yes)
      :Hash new password;
      :Update user password;
      :Mark reset code used;
      |Frontend|
      :Show success;
      :Navigate to Login;
      stop
    else (no)
      :Return invalid or expired code;
      |Frontend|
      :Show reset error and allow retry;
      stop
    endif
  else (no)
    :Return generic response;
    |Frontend|
    :Show safe email message;
    stop
  endif
else (no)
  :Show email validation error;
  stop
endif
@enduml
