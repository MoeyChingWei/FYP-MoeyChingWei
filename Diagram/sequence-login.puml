@startuml
title Sequence Diagram - Login and Role/Department Access

actor User
participant "React Login" as FE
participant "Auth Route" as Auth
database "Prisma / PostgreSQL" as DB
participant "App Router / RBAC" as Guard

User -> FE: Enter email and password
FE -> FE: Validate required fields
alt invalid fields
  FE --> User: Show validation error
else valid fields
  FE -> Auth: POST /api/login
  Auth -> DB: Find user by email
  DB --> Auth: User record / null
  Auth -> Auth: Compare password and isActive
  alt invalid credentials or inactive
    Auth --> FE: 401 unauthorized
    FE --> User: Show login error
  else valid account
    Auth --> FE: 200 user role + department
    FE -> Guard: Evaluate permitted routes
    Guard -> Guard: Finance = Admin OR finance role + Finance/FIN
    Guard -> Guard: Manager Overview hides statistic cards
    alt Supplier
      Guard --> FE: Navigate /supplier-overview
    else other roles
      Guard --> FE: Navigate /overview
    end
    FE --> User: Render role-scoped navigation
  end
end
@enduml
