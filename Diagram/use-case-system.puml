@startuml
title Use Case Diagram - OptiMind Portal (Current Role Scope)
left to right direction

actor Employee
actor "Department Executive" as Executive
actor Manager
actor "Treasury / Finance Officer" as FinanceOfficer
actor "Payment Team" as PaymentTeam
actor Supplier
actor Admin

rectangle "FYP MoeyChingWei System" {
  usecase "Login / Reset Password" as Auth
  usecase "View Role-Scoped Overview" as Overview
  usecase "Manage Own Profile" as Profile
  usecase "Create and Save PR Draft" as Draft
  usecase "Submit Purchase Request" as SubmitPR
  usecase "Review PR" as ReviewPR
  usecase "Create and Review PO" as PO
  usecase "Approve PO" as ApprovePO
  usecase "Acknowledge Order" as Ack
  usecase "Submit Delivery" as Delivery
  usecase "Verify GRN / Report Discrepancy" as GRN
  usecase "Submit Supplier Invoice" as Invoice
  usecase "Approve Supplier Invoice" as InvoiceApproval
  usecase "Process Supplier Payment" as Payment
  usecase "View Budget / Forecast" as Forecast
  usecase "Submit Budget Proposal" as BudgetSubmit
  usecase "Approve Budget Adjustment" as BudgetApprove
  usecase "Manage Notifications" as Notifications
  usecase "Submit Feedback" as Feedback
  usecase "Use AI Assistant" as AI
  usecase "Manage Supplier Inventory" as Inventory
  usecase "Manage Purchasing Lookups" as Lookups
  usecase "Manage Users and Roles" as Users
  usecase "Review Audit / Export / Backup" as Operations
  usecase "Manage Tax and Bank Details" as SupplierSettings
}

Employee --> Auth
Employee --> Overview
Employee --> Profile
Employee --> Draft
Employee --> SubmitPR
Employee --> GRN
Employee --> Forecast
Employee --> Notifications
Employee --> Feedback
Employee --> AI

Executive --> Auth
Executive --> Overview
Executive --> ReviewPR
Executive --> PO
Executive --> GRN
Executive --> Forecast
Executive --> BudgetSubmit
Executive --> Notifications
Executive --> Feedback

Manager --> Auth
Manager --> Overview
Manager --> ReviewPR
Manager --> ApprovePO
Manager --> Forecast
Manager --> BudgetSubmit
Manager --> Notifications

FinanceOfficer --> Auth
FinanceOfficer --> Overview
FinanceOfficer --> InvoiceApproval
FinanceOfficer --> Forecast
FinanceOfficer --> BudgetApprove
FinanceOfficer --> Notifications

PaymentTeam --> Auth
PaymentTeam --> Overview
PaymentTeam --> Payment
PaymentTeam --> Forecast
PaymentTeam --> Notifications

Supplier --> Auth
Supplier --> Overview
Supplier --> Ack
Supplier --> Delivery
Supplier --> GRN
Supplier --> Invoice
Supplier --> Inventory
Supplier --> SupplierSettings
Supplier --> Notifications
Supplier --> Profile

Admin --> Auth
Admin --> Overview
Admin --> Profile
Admin --> Users
Admin --> Lookups
Admin --> Operations
Admin --> PO
Admin --> ApprovePO
Admin --> InvoiceApproval
Admin --> Payment
Admin --> Forecast
Admin --> BudgetApprove
Admin --> Notifications
Admin --> Feedback

SubmitPR .> Draft : may start from
SubmitPR .> Forecast : reserve budget
ReviewPR .> Notifications : <<include>>
ApprovePO .> Notifications : <<include>>
GRN .> Delivery : discrepancy resend
GRN .> Invoice : completed GRN enables
InvoiceApproval .> Payment : approved invoice creates

note "Finance module visibility = Admin OR (Treasury/Finance Officer or Payment Team in Finance/FIN department). Manager Overview hides statistic cards." as AccessRule
AccessRule .. Overview
@enduml
