@startuml
title Activity (Detailed) - Forgot Password and Reset Password

start
:Open "Forgot Password" page;
:Enter registered email;
:Submit request;
:System sends POST /api/forgot-password;

if (Email format valid?) then (Yes)
  :System verifies captcha (if enabled);
  if (Captcha valid?) then (Yes)
    :System generates one-time code\n(for existing account);
    :System sends code by email;
    :Show generic success message\n(to protect account privacy);
    :User opens Reset Password page;
    :Enter email + verification code + new password;
    :System sends POST /api/reset-password;
    if (All fields valid?) then (Yes)
      :System checks code validity and expiry;
      if (Code valid and not expired?) then (Yes)
        :Hash new password and update account;
        :Show "Password has been reset";
        :User returns to Login and signs in;
      else (No)
        :Show "Invalid or expired verification code";
      endif
    else (No)
      :Show input validation message;
    endif
  else (No)
    :Show captcha failed message;
  endif
else (No)
  :Show "Email is required";
endif

stop
@enduml
