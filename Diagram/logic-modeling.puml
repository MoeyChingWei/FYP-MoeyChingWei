@startuml
title Logic Modeling - Access, Workflow, Budget and Finance Rules
skinparam packageStyle rectangle

package "Access Logic" {
  class UserContext {
    +role
    +department
    +isActive
  }
  class AuthLogic {
    +login(email, password)
    +forgotPassword(email)
    +resetPassword(code, newPassword)
    +patchProfile(data)
  }
  class RouteGuard {
    +canAccessPath(role, pathname)
    +canAccessFinance(role, department)
    +fallbackPath(role)
  }
  UserContext --> AuthLogic
  UserContext --> RouteGuard
}

package "Purchasing Workflow" {
  class WorkflowStore {
    +purchase-requests
    +purchase-orders
    +supplier-order-acks
    +deliveries
    +grns
  }
  class WorkflowSync {
    +GET snapshot
    +PUT rows + baseLocalIds
    +upsert and delete stale rows
  }
  class StatusRules {
    +DRAFT -> SUBMITTED
    +REQUEST_CHANGE / REJECTED
    +APPROVED -> PO
    +DISCREPANCY -> resend
  }
  WorkflowSync --> WorkflowStore
  WorkflowStore --> StatusRules
}

package "Supplier Finance" {
  class FinanceApi {
    +invoice from completed GRN
    +supplier submit invoice
    +finance approve/reject
    +payment team process
  }
  class FinanceStatusRules {
    +PENDING_APPROVAL
    +APPROVED -> PENDING_PAYMENT
    +PAID / REJECTED
  }
  FinanceApi --> FinanceStatusRules
}

package "Budget Logic" {
  class BudgetRules {
    +reserve on PR submission
    +release on rejection/change
    +deduct on completion
    +own department scope
  }
  class ForecastRules {
    +approved requests only
    +monthly/quarterly/yearly aggregation
    +three-period moving average
    +confidence from trend
  }
  class AdjustmentRules {
    +Executive/Manager submit own department
    +Finance/Admin approve or reject
  }
  BudgetRules --> ForecastRules
  ForecastRules --> AdjustmentRules
}

package "Notification Logic" {
  class NotificationService {
    +workflow transition alerts
    +budget review alerts
    +invoice/payment alerts
    +feedback admin alert
  }
  class NotificationStore {
    +read and unread
    +read-all
    +delete one/history
  }
  NotificationService --> NotificationStore
}

package "AI and Feedback" {
  class AiService {
    +chat and stream response
    +session history
    +document/source upload
  }
  class FeedbackRules {
    +ISSUE / IMPROVEMENT / COMMENT
    +description minimum length
    +Admin review state
  }
  AiService --> FeedbackRules : separate support module
}

RouteGuard --> FinanceApi : Finance/FIN + finance role
WorkflowStore --> BudgetRules
WorkflowStore --> NotificationService
FinanceApi --> NotificationService
AdjustmentRules --> NotificationService
FeedbackRules --> NotificationService
@enduml
