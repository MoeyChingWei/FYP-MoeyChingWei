@startuml
title Logic Modeling - Core Business Rules

skinparam packageStyle rectangle

package "Access Logic" {
  class User {
    +id
    +role
    +isActive
  }
  class AuthLogic {
    +login(email, password)
    +forgotPassword(email)
    +resetPassword(email, code, newPassword)
    +patchProfile(userId, data)
    +uploadProfileAvatar(file)
  }
  class RoleGuard {
    +canAccessPath(role, pathname)
    +fallbackPath(role)
  }
  User --> AuthLogic : authenticates
  User --> RoleGuard : authorize route
}

package "Workflow Logic" {
  class WorkflowStorageRoute {
    +get(store)
    +put(store, rows[])
  }
  class StoreResolver {
    +mapStoreToModel(store)
    +stores = {purchase-requests, purchase-orders,\nsupplier-order-acks, deliveries, grns}
  }
  class RowValidation {
    +check rows[] has localId
  }
  class SyncTransaction {
    +delete missing rows
    +upsert incoming rows
  }
  class NotificationRuleEngine {
    +processWorkflowNotifications(store, before, after)
  }

  WorkflowStorageRoute --> StoreResolver
  WorkflowStorageRoute --> RowValidation
  WorkflowStorageRoute --> SyncTransaction
  WorkflowStorageRoute --> NotificationRuleEngine : async trigger
}

package "Feedback Logic" {
  class FeedbackRoute {
    +post(userId, type, description)
    +get()
  }
  class FeedbackValidation {
    +type in {ISSUE, IMPROVEMENT, COMMENT}
    +description length >= 5
  }
  class FeedbackNotification {
    +notifyAdminsForFeedback(...)
  }

  FeedbackRoute --> FeedbackValidation
  FeedbackRoute --> FeedbackNotification
}

package "Notification Logic" {
  class NotificationRoute {
    +get(userId)
    +patch(id/read)
    +patch(read-all)
    +delete(id)
    +delete(history)
  }
  class NotificationPersistence {
    +insert notification rows
    +update isRead/readAt
    +delete read history
  }
  NotificationRoute --> NotificationPersistence
}

@enduml
