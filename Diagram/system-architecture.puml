@startuml
title System Architecture - FYP MoeyChingWei (Current Modules)
left to right direction
skinparam componentStyle rectangle

actor "Authenticated User" as User
actor Admin

node "Browser" {
  component "React SPA\nApp Router + session" as SPA
  component "Feature Pages\nOverview | Purchasing | Supplier | Budget | Finance | Settings" as Pages
  component "Shared API Clients\nworkflow sync + role guards" as Clients
}

node "Express API :4000" {
  package "Identity and shared" {
    component "Auth/Profile\n/api/login, /api/profile" as Auth
    component "Notifications/Feedback\n/api/notifications, /api/feedback" as Shared
    component "Admin/Audit/Export/Backup" as AdminApi
  }
  package "Business APIs" {
    component "Workflow snapshot API\n/api/workflow/:store" as Workflow
    component "Purchasing + Inventory\n/api/purchasing/*" as PurchaseApi
    component "Supplier Finance/Tax\n/api/supplier-finance/*\n/api/supplier-tax/*" as FinanceApi
    component "Budget API\n/api/budget/*\n/api/department-budget/*" as BudgetApi
  }
  package "AI and integrations" {
    component "Chatbot / Agents / Sources" as AiApi
    component "Gmail OAuth and email" as GmailApi
    component "Notification Service" as Notify
    component "Budget Prediction Service" as Predict
  }
}

database "PostgreSQL" as DB
component "Prisma Client" as Prisma
folder "uploads/" as Uploads
cloud "Gmail / SMTP" as Mail
cloud "AI Provider" as AI

User --> SPA
Admin --> SPA
SPA --> Pages
Pages --> Clients
Clients --> Auth
Clients --> Shared
Clients --> AdminApi
Clients --> Workflow
Clients --> PurchaseApi
Clients --> FinanceApi
Clients --> BudgetApi
Clients --> AiApi
Clients --> GmailApi

Auth --> Prisma
Shared --> Prisma
AdminApi --> Prisma
Workflow --> Prisma
PurchaseApi --> Prisma
FinanceApi --> Prisma
BudgetApi --> Prisma
AiApi --> Prisma
Prisma --> DB
Auth --> Uploads
PurchaseApi --> Uploads
FinanceApi --> Uploads
AiApi --> Uploads
Workflow --> Notify
Shared --> Notify
BudgetApi --> Notify
FinanceApi --> Notify
BudgetApi --> Predict
Notify --> Prisma
Notify --> GmailApi
GmailApi --> Mail
AiApi --> AI

note right of Clients
Finance UI is rendered only for Admin or
Finance roles in the Finance/FIN department.
Manager Overview omits statistic cards.
end note
@enduml
