@startuml
title Component Diagram - Current Frontend, API and Services
left to right direction

package "Frontend (React + TypeScript)" {
  [App Router / RBAC Guard] as Router
  [Overview and Notifications] as Overview
  [User Access / Profile] as Access
  [Purchasing PR and PO] as Purchasing
  [Supplier Fulfillment] as Fulfillment
  [Budget Management] as Budget
  [Finance Invoice and Payment] as Finance
  [Settings / Feedback / AI] as Settings
  [Tracking and Inventory] as Tracking
  [Shared API + Workflow Sync] as Client
}

package "Backend (Node.js + Express)" {
  [Auth and Profile Routes] as Auth
  [Workflow Storage Routes] as Workflow
  [Purchasing and Inventory Routes] as PurchasingApi
  [Supplier Finance and Tax Routes] as SupplierFinance
  [Department Budget Routes] as BudgetApi
  [Notifications and Feedback Routes] as SharedApi
  [Admin / Audit / Export / Backup Routes] as AdminApi
  [Chatbot / Agents / Sources Routes] as AiApi
  [Gmail Integration] as Gmail
  [Notification Service] as NotificationService
  [Budget Prediction Service] as PredictionService
}

database "PostgreSQL via Prisma" as DB
folder "uploads/" as Uploads
cloud "Gmail / SMTP" as Mail
cloud "AI Provider" as AI

Router --> Overview
Router --> Access
Router --> Purchasing
Router --> Fulfillment
Router --> Budget
Router --> Finance
Router --> Settings
Router --> Tracking
Overview --> Client
Access --> Client
Purchasing --> Client
Fulfillment --> Client
Budget --> Client
Finance --> Client
Settings --> Client
Tracking --> Client

Client --> Auth
Client --> Workflow
Client --> PurchasingApi
Client --> SupplierFinance
Client --> BudgetApi
Client --> SharedApi
Client --> AdminApi
Client --> AiApi

Auth --> DB
Auth --> Uploads
Workflow --> DB
PurchasingApi --> DB
PurchasingApi --> Uploads
SupplierFinance --> DB
SupplierFinance --> Uploads
BudgetApi --> DB
BudgetApi --> PredictionService
SharedApi --> DB
AdminApi --> DB
AiApi --> DB
AiApi --> Uploads
Workflow --> NotificationService
BudgetApi --> NotificationService
SupplierFinance --> NotificationService
SharedApi --> NotificationService
NotificationService --> DB
NotificationService --> Gmail
Auth --> Gmail : reset email
AiApi --> AI
Gmail --> Mail
@enduml
